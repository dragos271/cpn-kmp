      <ml id="ID1000182">val MEAN_GAP = 30.0;   (* minutes between arriving cases, on average *)<layout>val MEAN_GAP = 30.0;   (* minutes between arriving cases, on average *)</layout></ml>
      <ml id="ID1000183">(* A standard ML function, as CPN Tools has them. *)
fun arrivalGap () = Int.max (1, round (exponential (1.0 / MEAN_GAP)));<layout>(* A standard ML function, as CPN Tools has them. *)
fun arrivalGap () = Int.max (1, round (exponential (1.0 / MEAN_GAP)));</layout></ml>
      <ml id="ID1000184">fun orderMore () = discrete (1, 10) = 1;   (* one case in ten needs more slides *)<layout>fun orderMore () = discrete (1, 10) = 1;   (* one case in ten needs more slides *)</layout></ml>
      <ml id="ID1000185">(* Computed by an external tool, Python (see patholab.py). CPN Tools uses this body instead. *)
(* @python patholab.py delay_section *)
fun delaySection (w : INT, skill : INT) : INT = 300 div skill;<layout>(* Computed by an external tool, Python (see patholab.py). CPN Tools uses this body instead. *)
(* @python patholab.py delay_section *)
