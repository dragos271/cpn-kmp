{
 "format": "cpn-document",
 "version": 1,
 "name": "TwoPhaseCommit",
 "declarations": "val W = 2;\ncolset UNIT = unit;\ncolset Worker = index wrk with 1..W;\ncolset Workers = list Worker;\ncolset Vote = with Yes | No;\ncolset WorkerxVote = product Worker * Vote;\ncolset WorkerxVotes = list WorkerxVote;\ncolset Decision = with abort | commit;\ncolset WorkerxDecision = product Worker * Decision;\nvar w : Worker;\nvar workers : Workers;\nvar vote : Vote;\nvar votes : WorkerxVotes;\nvar decision : Decision;\nfun AddVote ((w,vote),votes) = (w,vote) :: votes;\nfun yesVotes votes = List.filter (fn (w,vote) => vote = Yes) votes;\nfun YesWorkers votes = List.map (fn (w,_) => w) (yesVotes votes);\nfun InformYesWorkers votes = let val yesworkers = YesWorkers votes val decision = (if (List.length yesworkers = W) then commit else abort) in List.map (fn w => (w,decision)) yesworkers end;\nfun All votes = (List.length votes = W);\n",
